<resources>
    <!-- Badges. Calm, plain and honest: badges mark practice that happened, never pressure. -->

    <!-- Badge names -->
    <string name="badges_name_steady_start">Steady Start</string>
    <string name="badges_name_unbroken">Unbroken</string>
    <string name="badges_name_seven_days">Seven Days</string>
    <string name="badges_name_night_tide">Night Tide</string>
    <string name="badges_name_four_winds">Four Winds</string>
    <string name="badges_name_deep_water">Deep Water</string>
    <string name="badges_name_square_mind">Square Mind</string>
    <string name="badges_name_mountain">Mountain</string>

    <!-- What each badge takes, as shown in "Next up". -->
    <string name="badges_requirement_steady_start">Complete 3 full sessions within 7 days.</string>
    <string name="badges_requirement_unbroken">Finish a 10-minute session without pausing.</string>
    <string name="badges_requirement_seven_days">Breathe on 7 different days within any 14-day window.</string>
    <string name="badges_requirement_night_tide">Complete 5 Sleep sessions started after 9 pm.</string>
    <string name="badges_requirement_four_winds">Complete each of the four patterns 3 times.</string>
    <string name="badges_requirement_deep_water">Breathe for 100 minutes in full sessions.</string>
    <string name="badges_requirement_square_mind">Complete 10 full Box breathing sessions.</string>
    <string name="badges_requirement_mountain">Breathe on 30 different days within 60 days.</string>

    <!-- Badge Earned sheet: one warm sentence naming the practice that earned the badge. -->
    <string name="badges_message_steady_start">Three full sessions in a single week. A new habit, off the ground.</string>
    <string name="badges_message_unbroken">Ten minutes, start to finish, without a pause. You stayed with it when it got restless.</string>
    <string name="badges_message_seven_days">You breathed on 7 different days in under two weeks. That\'s a habit taking root.</string>
    <string name="badges_message_night_tide">Five Sleep sessions late in the evening. Breathing, right when it helps most.</string>
    <string name="badges_message_four_winds">Every pattern, three times over. You know which rhythm suits which moment.</string>
    <string name="badges_message_deep_water">A hundred minutes of full sessions, counted honestly. Time well spent.</string>
    <string name="badges_message_square_mind">Ten full Box sessions. Real depth in a single technique.</string>
    <string name="badges_message_mountain">Thirty days of breathing in two months. A lasting habit, built slowly.</string>

    <!-- Status under a badge -->
    <string name="badges_earned">Earned</string>

