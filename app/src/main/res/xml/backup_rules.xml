<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and lower (see data_extraction_rules.xml for Android 12+).
     Everything the app keeps is in the "breathe" preferences: settings, session history, streak,
     badges and reminder times. Backing it up means a new phone keeps the user's practice. -->
<full-backup-content>
    <include domain="sharedpref" path="breathe.xml" />
</full-backup-content>
