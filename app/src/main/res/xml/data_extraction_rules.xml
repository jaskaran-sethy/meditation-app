<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer on Android 12+ (see backup_rules.xml for older versions).
     Only the "breathe" preferences hold user data: settings, session history, streak, badges and
     reminder times. The reminder alarm is scheduled again when the app next opens. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="breathe.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="breathe.xml" />
    </device-transfer>
</data-extraction-rules>
